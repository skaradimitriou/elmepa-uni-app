<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/grey_bg</item>

        <item name="colorPrimary">@color/petrol</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/petrol</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSurface">@color/petrol_15_opacity</item>
        <item name="colorSurfaceContainer">@color/petrol_15_opacity</item>
        <item name="colorSecondary">@color/petrol_15_opacity</item>
        <item name="colorTertiary">@color/petrol_15_opacity</item>
        <item name="colorTertiaryContainer">@color/petrol_15_opacity</item>
        <item name="colorSurfaceDim">@color/petrol_15_opacity</item>

        <item name="android:statusBarColor">@color/blue_darker</item>
        <item name="actionBarStyle">@style/AppToolbar</item>

        <!-- Bottom Navigation -->
        <item name="colorSecondaryContainer">@color/petrol_15_opacity</item>
    </style>

    <!-- App Styling -->
    <style name="AppToolbar" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="android:background">@color/petrol</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="titleTextColor">@color/white</item>
        <item name="textColorSearchUrl">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="hintTextColor">@color/white</item>
        <item name="editTextColor">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <style name="AppBottomNavMenu" parent="Widget.Material3.BottomNavigationView">
        <item name="background">@color/petrol</item>
        <item name="android:textColor">@color/white</item>
        <item name="itemTextColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="AppMaterialCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/dimen_10</item>
        <item name="cardForegroundColor">@android:color/transparent</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="AppMaterialCardSecondary" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/dimen_10</item>
    </style>

    <style name="AppRecyclerStyle">
        <item name="android:paddingBottom">@dimen/dimen_40</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:orientation">vertical</item>
        <item name="android:overScrollMode">never</item>
    </style>

    <!-- Text Styles -->
    <style name="text_20_bold" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:textSize">@dimen/text_20</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="text_20" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:textColor">@color/text_grey_dark</item>
        <item name="android:textSize">@dimen/text_20</item>
    </style>

    <style name="text_18_bold" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:textColor">@color/text_grey_dark</item>
        <item name="android:textSize">@dimen/text_18</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="text_18" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:textColor">@color/text_grey_dark</item>
        <item name="android:textSize">@dimen/text_18</item>
    </style>

    <style name="text_16_bold" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:textColor">@color/text_grey_dark</item>
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="text_16" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:textColor">@color/text_grey_dark</item>
        <item name="android:textSize">@dimen/text_16</item>
    </style>

</resources>
