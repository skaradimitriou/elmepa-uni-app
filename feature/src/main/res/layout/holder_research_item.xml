<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.stathis.model.research.ResearchItem" />

        <variable
            name="callback"
            type="com.stathis.feature.ui.research.recycler.ResearchCallback" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        style="@style/AppMaterialCard"
        android:layout_height="wrap_content"
        android:onClick="@{() -> callback.onResearchItemTap(model)}"
        app:cardCornerRadius="@dimen/margin_10">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/itemImgView"
                android:layout_width="@dimen/dimen_85"
                android:layout_height="@dimen/dimen_85"
                android:contentDescription="@tools:sample/lorem"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:loadLocalPhoto="@{model.imageResource}"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/titleTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_10"
                android:text="@{model.name}"
                android:textColor="@color/dark_grey"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/itemImgView"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@tools:sample/lorem" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>