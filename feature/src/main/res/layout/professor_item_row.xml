<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.stathis.model.professors.Professor" />

        <variable
            name="callback"
            type="com.stathis.feature.professors.adapter.ProfessorsCallback" />
    </data>

    <com.google.android.material.card.MaterialCardView
        style="@style/AppMaterialCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="@{() -> callback.onProfessorTap(model)}"
        app:cardCornerRadius="@dimen/dimen_10">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/professorImgView"
                android:layout_width="@dimen/height_70"
                android:layout_height="0dp"
                android:contentDescription="@tools:sample/lorem"
                android:padding="@dimen/dimen_10"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@id/professorEmailTxtView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:setGenderImage="@{model.gender}"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/professorNameTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dimen_16"
                android:text="@{model.fullName}"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/text_16"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/professorImgView"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@tools:sample/lorem" />

            <TextView
                android:id="@+id/professorEmailTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/dimen_16"
                android:text="@{model.email}"
                android:textSize="@dimen/text_16"
                app:layout_constraintEnd_toEndOf="@id/professorNameTxtView"
                app:layout_constraintStart_toStartOf="@id/professorNameTxtView"
                app:layout_constraintTop_toBottomOf="@id/professorNameTxtView"
                tools:text="@tools:sample/lorem" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>