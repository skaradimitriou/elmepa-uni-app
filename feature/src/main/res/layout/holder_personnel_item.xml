<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.stathis.model.personnel.Person" />

        <variable
            name="callback"
            type="com.stathis.feature.ui.personnel.adapter.PersonnelCallback" />
    </data>

    <com.google.android.material.card.MaterialCardView
        style="@style/AppMaterialCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="@{() -> callback.onPersonTap(model)}"
        app:cardCornerRadius="@dimen/dimen_10">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/personnelImgView"
                android:layout_width="@dimen/dimen_100"
                android:layout_height="0dp"
                android:contentDescription="@tools:sample/lorem"
                android:padding="@dimen/dimen_16"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@id/personnelEmailTxtView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:personnelGender="@{model.gender}"
                app:setPersonnelImage="@{model.image}"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/personnelNameTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dimen_16"
                android:text="@{model.fullName}"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/personnelImgView"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@tools:sample/lorem" />

            <TextView
                android:id="@+id/personnelDescriptionTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/dimen_5"
                android:paddingBottom="@dimen/dimen_16"
                android:text="@{model.description}"
                android:textSize="@dimen/text_16"
                app:layout_constraintEnd_toEndOf="@id/personnelNameTxtView"
                app:layout_constraintStart_toStartOf="@id/personnelNameTxtView"
                app:layout_constraintTop_toBottomOf="@id/personnelNameTxtView"
                tools:text="@tools:sample/lorem" />

            <TextView
                android:id="@+id/personnelEmailTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/dimen_16"
                android:text="@{model.email}"
                android:textSize="@dimen/text_16"
                app:layout_constraintEnd_toEndOf="@id/personnelDescriptionTxtView"
                app:layout_constraintStart_toStartOf="@id/personnelDescriptionTxtView"
                app:layout_constraintTop_toBottomOf="@id/personnelDescriptionTxtView"
                tools:text="@tools:sample/lorem" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>