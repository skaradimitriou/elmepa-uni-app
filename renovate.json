{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Athens",
  "addLabels": [
    "Dependency Updates"
  ],
  "packageRules": [
    {
      "description": "Wait 14 days before creating major update PRs",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Wait 7 days before creating minor update PRs",
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Wait 30 days before creating patch update PRs",
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "30 days"
    },
    {
      "groupName": "Kotlin & Friends",
      "matchPackageNames": [
        "/org.jetbrains.kotlin:*/",
        "/com.google.devtools.ksp/"
      ]
    },
    {
      "groupName": "AGP & Friends",
      "matchPackageNames": [
        "/com.android.application/",
        "/com.android.library/",
        "/com.android.tools.build/"
      ]
    },
    {
      "groupName": "AndroidX & Jetpack Compose",
      "matchPackageNames": [
        "/androidx.core/",
        "/androidx.lifecycle/",
        "/androidx.activity/activity-compose/",
        "/androidx.compose/",
        "/androidx.compose.ui/",
        "/androidx.compose.material3/",
        "/androidx.navigation/navigation-compose/"
      ]
    },
    {
      "groupName": "Testing",
      "matchPackageNames": [
        "/org.junit.jupiter/",
        "/androidx.test.ext/",
        "/androidx.test.espresso/",
        "/org.jetbrains.kotlinx/kotlinx-coroutines-test/",
        "/io.mockk/"
      ]
    }
  ]
}
